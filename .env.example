DATABASE_URL="file:./dev.db"

JWT_SECRET="change-me-in-production-super-secret-key"
JWT_EXPIRES_IN="7d"

PORT=3001
NODE_ENV=development

# Redis — REQUIRED for BullMQ job queues (notifications, WhatsApp, reports)
# Install: sudo apt-get install redis-server && sudo systemctl enable --now redis-server
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CORS_ORIGINS=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

WHATSAPP_SESSION_DIR=./.wwebjs_auth
